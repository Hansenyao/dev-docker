#!/usr/bin/env bash
# Git credential helper that serves GitHub tokens mounted from macOS, one file
# per repository owner: /run/secrets/ai-dev/github/<owner> (case-insensitive).
# /etc/gitconfig registers it as `helper = ghtoken` for https://github.com with
# `useHttpPath = true`, so git sends the repository path the owner comes from.
# Only `get` is answered; `store` and `erase` are ignored because the token
# files belong to the host and are mounted read-only.
set -euo pipefail

token_dir="${AI_DEV_TOKEN_DIR:-/run/secrets/ai-dev/github}"

# token_for_owner OWNER: prints the owner's token, or fails if there is none.
token_for_owner() {
  local owner f name
  owner="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  for f in "$token_dir"/*; do
    [ -f "$f" ] && [ -s "$f" ] || continue
    name="$(basename "$f" | tr '[:upper:]' '[:lower:]')"
    if [ "$name" = "$owner" ]; then
      tr -d '[:space:]' < "$f"
      return 0
    fi
  done
  return 1
}

# give_up MESSAGE: explains the problem and tells git not to prompt for a password.
give_up() {
  echo "git-credential-ghtoken: $1" >&2
  echo "quit=1"
  exit 0
}

[ "${1:-}" = "get" ] || exit 0

host=""
path=""
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case "$line" in
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done

[ "$host" = "github.com" ] || exit 0

path="${path#/}"
if [ -z "$path" ]; then
  give_up "git sent no repository path; set credential.useHttpPath=true for https://github.com"
fi

owner="${path%%/*}"
if token="$(token_for_owner "$owner")"; then
  printf 'username=x-access-token\npassword=%s\n' "$token"
else
  give_up "no token for owner $owner; save one on macOS as ~/.ai-dev/secrets/github/$owner"
fi
