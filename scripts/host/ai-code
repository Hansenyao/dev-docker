#!/usr/bin/env bash
# Opens a dedicated VS Code instance for attaching to the ai-dev container.
# The Dev Containers extension forwards the macOS SSH agent whenever its own
# process has SSH_AUTH_SOCK set, and has no setting to turn that off, so this
# instance is started without SSH_AUTH_SOCK. It also uses its own user data
# and extensions directories, leaving the normal VS Code untouched.
#
# The window is started from the app binary, not the `code` CLI: on macOS the
# CLI launches the app through `open`, which gives it launchd's environment
# (including SSH_AUTH_SOCK) instead of ours. VSCODE_CLI=1 tells VS Code it was
# started from a shell, so it keeps this environment instead of re-reading it
# from a login shell.
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/../.." && pwd)"
app="${AI_DEV_CODE_APP:-/Applications/Visual Studio Code.app}"
code_bin="$app/Contents/Resources/app/bin/code"
app_bin="$app/Contents/MacOS/Code"
base="${AI_DEV_VSCODE_DIR:-$HOME/Library/Application Support/ai-dev-vscode}"
data_dir="$base/data"
ext_dir="$base/extensions"

if [ ! -x "$code_bin" ] || [ ! -x "$app_bin" ]; then
  echo "VS Code not found at $app" >&2
  exit 1
fi

mkdir -p "$data_dir/User" "$ext_dir"
cp "$repo_dir/vscode/settings.json" "$data_dir/User/settings.json"

dirs=(--user-data-dir "$data_dir" --extensions-dir "$ext_dir")

if ! "$code_bin" "${dirs[@]}" --list-extensions | grep -qx 'ms-vscode-remote.remote-containers'; then
  "$code_bin" "${dirs[@]}" --install-extension ms-vscode-remote.remote-containers
fi

env -u SSH_AUTH_SOCK -u ELECTRON_RUN_AS_NODE VSCODE_CLI=1 \
  nohup "$app_bin" "${dirs[@]}" --new-window "$@" >/dev/null 2>&1 &
